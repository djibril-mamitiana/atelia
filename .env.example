# ─────────────────────────────────────────────────────────────
# Database — PostgreSQL on Railway
# ─────────────────────────────────────────────────────────────
# Locally: Railway → PostgreSQL service → Variables → DATABASE_PUBLIC_URL
# (the *.railway.internal DATABASE_URL only resolves inside Railway).
# Prefer a test database over production for local development.
# On Railway, the app service sets DATABASE_URL=${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://postgres:password@xxxx.proxy.rlwy.net:12345/railway"
# Optional, only for a pooled setup — leave unset on Railway (the Prisma CLI
# would otherwise run migrations against this URL instead of DATABASE_URL).
# DATABASE_URL_UNPOOLED=""

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# Secret used to sign session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ─────────────────────────────────────────────────────────────
# Payment — manual bank transfer (active payment method)
# ─────────────────────────────────────────────────────────────
# Shown to customers on the order confirmation page after checkout.
BANK_TRANSFER_HOLDER="Nom du titulaire du compte"
BANK_TRANSFER_IBAN="FRxx xxxx xxxx xxxx xxxx xxxx xxx"
BANK_TRANSFER_BIC="XXXXXXXX"
BANK_TRANSFER_BANK_NAME="Nom de la banque"

# ─────────────────────────────────────────────────────────────
# Stripe (optional) — not used for now; the active payment method is
# manual bank transfer above. Fill these in only if you switch back to
# card payments (see src/server/actions/checkout.actions.ts history).
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─────────────────────────────────────────────────────────────
# Email (optional) — password reset links work without this (logged to the
# server console in dev); add a Resend key to actually deliver them.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Atelia <no-reply@votre-domaine.example>"
SUPPORT_EMAIL="support@votre-domaine.example"

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
