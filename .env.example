# ─────────────────────────────────────────────────────────────
# Database — Neon PostgreSQL
# ─────────────────────────────────────────────────────────────
# 1. Create a free project at https://neon.tech
# 2. Dashboard → Connection string. Neon gives you a pooled connection
#    (for the app) and can also give an unpooled one (for migrations).
# DATABASE_URL:        pooled connection, used by the app at runtime (pgbouncer).
# DATABASE_URL_UNPOOLED: direct connection, used by `prisma migrate`.
#    If your Neon project only shows one string, use it for both.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# Secret used to sign session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ─────────────────────────────────────────────────────────────
# Payment — manual bank transfer (active payment method)
# ─────────────────────────────────────────────────────────────
# Shown to customers on the order confirmation page after checkout.
BANK_TRANSFER_HOLDER="Nom du titulaire du compte"
BANK_TRANSFER_IBAN="FRxx xxxx xxxx xxxx xxxx xxxx xxx"
BANK_TRANSFER_BIC="XXXXXXXX"
BANK_TRANSFER_BANK_NAME="Nom de la banque"

# ─────────────────────────────────────────────────────────────
# Stripe (optional) — not used for now; the active payment method is
# manual bank transfer above. Fill these in only if you switch back to
# card payments (see src/server/actions/checkout.actions.ts history).
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─────────────────────────────────────────────────────────────
# Email (optional) — password reset links work without this (logged to the
# server console in dev); add a Resend key to actually deliver them.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Atelia <no-reply@votre-domaine.example>"
SUPPORT_EMAIL="support@votre-domaine.example"

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
